{
  "name": "researchstarter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @researchstarter/web --",
    "build": "npm run build --workspace @researchstarter/web --",
    "lint": "npm run lint --workspace @researchstarter/web --",
    "preview": "npm run preview --workspace @researchstarter/web --",
    "server": "npm run start --workspace @researchstarter/api --",
    "db:check": "npm run db:check --workspace @researchstarter/api --",
    "db:migrate": "npm run db:migrate --workspace @researchstarter/api --"
  }
}
